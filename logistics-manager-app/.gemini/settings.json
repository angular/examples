{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": [
        "-y",
        "@angular/cli",
        "mcp"
      ],
      "disabledTools": [
        "ai_tutor"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
