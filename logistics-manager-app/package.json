    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.3",
    "@genkit-ai/google-genai": "^1.42.0",
    "express": "^5.1.0",
    "genkit": "^1.14.0",
    "leaflet": "^1.9.4",
